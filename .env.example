APP_NAME=AI IT Helpdesk
ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_it_helpdesk
SEED_TICKET_LIMIT=1000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=180
# Real exports are isolated from synthetic telemetry and disabled by default.
ENABLE_REAL_TELEMETRY=false
# Change before starting the optional local observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
# Optional local-only RCA trace. Leave unset to disable tracing.
# RCA_TRACE_PATH=./data/eval/rca_traces.jsonl
